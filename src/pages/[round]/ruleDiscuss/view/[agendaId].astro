---
export const prerender = false

import RoundLayout from '@/layouts/Round.astro'
import UserLink from '@/components/common/preact/UserLink'
import Issue from '@/components/round/ruleAgenda/Issue.astro'
import { getConnection } from '@/libs/databases'
import { getCurrentRound, getCurrentPageFullTitle, getMuseumMainPageUrl } from '@/libs/routes'
import { getCurrentRound as getCurrentRoundFromDB } from '@/services/dbRound'
import { getAgendaById } from '@/services/dbRuleAgendas'
import { getRelatedIssues } from '@/services/dbRuleIssues'
import { getRelatedIssueOptions } from '@/services/dbRuleIssueOptions'
import { markdownToHtml } from '@/utils/helpers'
import { flatten, keyBy, map } from 'lodash-es'

const round = getCurrentRound(Astro)!
const connection = getConnection(round)
const currentRound = await getCurrentRoundFromDB(connection)

const { agendaId = '' } = Astro.params
const agenda = await getAgendaById(connection, currentRound!, agendaId)

if (!agenda) {
  return Astro.redirect(getMuseumMainPageUrl())
}

const title = getCurrentPageFullTitle(Astro, agenda.title)

const descriptionHtml = markdownToHtml(agenda.description, true)

const issues = (await getRelatedIssues(connection, agenda.issues)) ?? []
const optionIds = flatten(map(issues, 'options'))
const issueOptions = (await getRelatedIssueOptions(connection, optionIds)) ?? []
const optionMap = keyBy(issueOptions, '_id')
const data = issues.map((issue) =>
  Object.assign({}, issue, {
    options: issue.options.map((optionId) => optionMap[optionId]),
  }),
)
---

<RoundLayout title={title}>
  <h1 class="round-block-title">{agenda.title}</h1>
  <div class="divider"></div>
  <h2 class="text-3xl">
    提案人：<UserLink client:only="preact" round={round} userId={agenda.proposer} />
  </h2>
  <p class="text-xl">
    議程建立委員：<UserLink client:only="preact" round={round} userId={agenda.creator} />
  </p>
  <p>
    活躍玩家人數：{agenda.activeUserCount} 人
  </p>
  <div class="divider"></div>
  <div>
    <div>
      <div class="flex flex-nowrap gap-x-2">
        <h3 class="text-2xl">議程介紹</h3>
        <a class="btn btn-sm btn-primary" href={agenda.discussionUrl} target="_blank">
          <i class="fa fa-external-link"></i>相關討論
        </a>
      </div>
      <div class="markdown-container px-4 py-2 break-all" set:html={descriptionHtml} />
    </div>
    {data.map((issue, index) => <Issue index={index} round={round} issue={issue} />)}
  </div>
</RoundLayout>
