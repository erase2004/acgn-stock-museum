---
export const prerender = false

import RoundLayout from '@/layouts/Round.astro'
import ListContainer from '@/components/round/fscStock/preact/ListContainer'
import LoadMore from '@/components/common/preact/LoadMore'
import { getConnection } from '@/libs/databases'
import { getCurrentRound, getRoundData } from '@/libs/routes'
import { getAccountOwnStocks } from '@/services/dbDirectors'
import { SpecialUser } from '@/services/dbUsers'

const userId = SpecialUser.FSC

const round = getCurrentRound(Astro)!
const roundData = getRoundData(round)!
const pageSize = roundData.config.dataNumberPerPage.fscStock
const connection = getConnection(round)!
const result = await getAccountOwnStocks(connection, userId, pageSize, 1)
const total = result?.[0]?.total[0]?.total ?? 0
const data = result?.[0]?.data ?? []
---

<RoundLayout>
  <h1 class="round-block-title">金管會持股</h1>
  <div class="divider"></div>
  <ListContainer
    client:only="preact"
    round={round}
    userId={userId}
    pageSize={pageSize}
    total={total}
    data={data}
  />
  <LoadMore client:only="preact" total={total} pageSize={pageSize} />
</RoundLayout>
