---
import type { GetStaticPaths } from 'astro'
import RoundLayout from '@/layouts/Round.astro'
import ListContainer from '@/components/round/fscStock/preact/ListContainer'
import LoadMore from '@/components/common/preact/LoadMore'
import { getConnection } from '@/libs/databases'
import { getCurrentRound } from '@/libs/routes'
import { getAccountOwnStocks } from '@/services/dbDirectors'
import { SpecialUser } from '@/services/dbUsers'
import { dataStoreKey } from '@/configs/general'
import { rounds } from '@/configs/sites'

export const getStaticPaths = (() => {
  return rounds.map((round) => ({
    params: {
      round,
    },
  }))
}) satisfies GetStaticPaths

const STORE_KEY = dataStoreKey.fscStock

const userId = SpecialUser.FSC

const round = getCurrentRound(Astro)!
const connection = getConnection(round)!

const fscStocks =
  (await (async function () {
    const result = await getAccountOwnStocks(connection, userId)
    return result?.[0].data
  })()) ?? []
---

<RoundLayout>
  <h1 class="round-block-title">金管會持股</h1>
  <div class="divider"></div>
  <ListContainer client:only="preact" round={round} data={fscStocks} storeKey={STORE_KEY} />
  <LoadMore client:only="preact" storeKey={STORE_KEY} />
</RoundLayout>
