---
import type { GetStaticPaths } from 'astro'
import { getConnection } from '@/libs/databases'
import { getArenaInfoUrl, getCurrentRound } from '@/libs/routes'
import { getLatestArena } from '@/services/dbArena'
import { rounds } from '@/configs/sites'

export const getStaticPaths = (() => {
  return rounds.map((round) => ({
    params: {
      round,
    },
  }))
}) satisfies GetStaticPaths

const round = getCurrentRound(Astro)!
const connection = getConnection(round)!
const latestArena = await getLatestArena(connection)

return Astro.redirect(getArenaInfoUrl(round, latestArena!._id))
---
