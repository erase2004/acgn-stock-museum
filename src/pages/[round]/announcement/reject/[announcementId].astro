---
export const prerender = false

import RoundLayout from '@/layouts/Round.astro'
import RejectionPetition from '@/components/round/announcement/RejectionPetition.astro'
import RejectionPoll from '@/components/round/announcement/RejectionPoll.astro'
import { getCurrentRound, getAnnouncementUrl, getRoundMainPageUrl } from '@/libs/routes'
import { getConnection } from '@/libs/databases'
import { getAnnouncementById } from '@/services/dbAnnouncements'
import { categoryDisplayName } from '@/utils/announcement'
import { getCurrentPageFullTitle } from '@/libs/routes'

const round = getCurrentRound(Astro)!
const connection = getConnection(round)!

const { announcementId = '' } = Astro.params
const announcement = await getAnnouncementById(connection, announcementId)

if (!announcement) {
  return Astro.redirect(getRoundMainPageUrl(round))
}

const title = getCurrentPageFullTitle(Astro, announcement.subject)
const canRejectAnnoumcenet = !!announcement.rejectionPetition
---

<RoundLayout title={title}>
  <h1 class="round-block-title">
    公告否決 - {categoryDisplayName(announcement.category)}
  </h1>
  <div class="divider"></div>
  <h2 class="text-3xl break-all">
    主旨：<a href={getAnnouncementUrl(round, announcement._id)}>{announcement.subject}</a>
  </h2>
  <div class="divider"></div>
  {
    canRejectAnnoumcenet ? (
      <Fragment>
        {announcement.rejectionPetition && <RejectionPetition {...announcement} round={round} />}
        {announcement.rejectionPoll && (
          <Fragment>
            <div class="divider" />
            <RejectionPoll {...announcement} round={round} />
          </Fragment>
        )}
      </Fragment>
    ) : (
      <Fragment>本公告沒有進行否決程序！</Fragment>
    )
  }
</RoundLayout>
