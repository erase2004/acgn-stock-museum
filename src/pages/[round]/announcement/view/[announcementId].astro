---
import type { GetStaticPaths } from 'astro'
import RoundLayout from '@/layouts/Round.astro'
import UserLink from '@/components/common/preact/UserLink'
import ClientDatetime from '@/components/common/preact/ClientDatetime'
import OpenGraph from '@/components/layout/OpenGraph.astro'
import {
  getCurrentRound,
  getAnnouncementRejectionUrl,
  getRoundMainPageUrl,
  getAccountUrl,
} from '@/libs/routes'
import { getConnection } from '@/libs/databases'
import { getAllBasicAnnouncements, getAnnouncementById } from '@/services/dbAnnouncements'
import { categoryDisplayName } from '@/utils/announcement'
import { markdownToHtml, removeMarkdown } from '@/utils/helpers'
import { getCurrentPageFullTitle } from '@/libs/routes'
import { legacyRounds, rounds } from '@/configs/sites'
import { flatten } from 'lodash-es'
import dayjs from 'dayjs'

export const getStaticPaths = (async () => {
  const results = await Promise.allSettled(
    rounds.map(async (round) => {
      const connection = getConnection(round)!
      const announcements = (await getAllBasicAnnouncements(connection)) ?? []

      return announcements.map((announcement) => ({
        params: {
          round,
          announcementId: announcement._id,
        },
      }))
    }),
  )

  return flatten(
    results.filter((result) => result.status === 'fulfilled').map((result) => result.value),
  )
}) satisfies GetStaticPaths

const round = getCurrentRound(Astro)!

if (legacyRounds.includes(round)) {
  return Astro.redirect(getRoundMainPageUrl(round))
}

const connection = getConnection(round)!

const { announcementId = '' } = Astro.params
const announcement = await getAnnouncementById(connection, announcementId)

if (!announcement) {
  return Astro.redirect(getRoundMainPageUrl(round))
}

const canRejectAnnoumcenet = !!announcement.rejectionPetition

const title = getCurrentPageFullTitle(Astro, announcement.subject)
const description = removeMarkdown(announcement.content)

const ldJson = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  author: [
    {
      '@type': 'Person',
      url: getAccountUrl(round, announcement.creator),
    },
  ],
  headline: title,
  datePublished: dayjs(announcement.createdAt).toISOString(),
}
---

<RoundLayout useUserDict={true}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(ldJson)} />
  <OpenGraph slot="head-seo" title={title} description={description} />
  <h1 class="round-block-title flex items-center justify-between">
    <div>公告 - {categoryDisplayName(announcement.category)}</div>
    {
      canRejectAnnoumcenet && (
        <a class="btn btn-warning" href={getAnnouncementRejectionUrl(round, announcementId)}>
          否決
        </a>
      )
    }
  </h1>
  <h2 class="my-2 text-3xl break-all">主旨：{announcement.subject}</h2>
  <p class="my-2 text-wrap">
    於 <ClientDatetime client:only="react" value={announcement.createdAt} /> 由 <UserLink
      client:only="react"
      round={round}
      userId={announcement.creator}
    /> 發佈
  </p>
  {
    announcement.voided && (
      <p class="my-2 text-warning">
        <i class="fa fa-warning" />
        已於 <ClientDatetime client:only="react" value={announcement.voidedAt} /> 由{' '}
        <UserLink client:only="react" round={round} userId={announcement.voidedBy} />
        以「{announcement.voidedReason}」的理由作廢！
      </p>
    )
  }
  <div class="divider"></div>
  <h2 class="my-2 text-3xl">內文：</h2>
  <div class="markdown-container" set:html={markdownToHtml(announcement.content, true)} />
</RoundLayout>
