---
import type { GetStaticPaths } from 'astro'
import RoundLayout from '@/layouts/Round.astro'
import Filter from '@/components/round/violation/preact/Filter'
import ListContainer from '@/components/round/violation/preact/ListContainer'
import { getCurrentRound, getRoundMainPageUrl, getViolationCaseUrl } from '@/libs/routes'
import { getViolationCases } from '@/services/dbViolationCases'
import { getCurrentRound as getCurrentRoundFromDB } from '@/services/dbRound'
import { getConnection } from '@/libs/databases'
import { STORE_KEY } from '@/stores/violation'
import { legacyRounds, rounds } from '@/configs/sites'
import { isLatestRound } from '@/utils/helpers'
import Reminder from '@/components/common/Reminder.astro'

export const getStaticPaths = (() => {
  return rounds.map((round) => ({
    params: {
      round,
    },
  }))
}) satisfies GetStaticPaths

const round = getCurrentRound(Astro)!

if (legacyRounds.includes(round)) {
  return Astro.redirect(getRoundMainPageUrl(round))
}

const connection = getConnection(round)!

let result
if (isLatestRound(round)) {
  result = await getViolationCases(connection)
} else {
  const roundData = await getCurrentRoundFromDB(connection)
  result = await getViolationCases(connection, roundData!.beginDate)
}

const data = result ?? []

const itemAmount = 3
const ldJson = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: data.slice(0, itemAmount).map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(getViolationCaseUrl(round, item._id), Astro.url),
  })),
}
const shouldShowLDJson = ldJson.itemListElement.length === itemAmount
---

<RoundLayout useUserDict={true} useProductDict={true}>
  {
    shouldShowLDJson && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(ldJson)} />
    )
  }
  <h1 class="round-block-title">違規案件列表</h1>
  <div class="divider"></div>
  <Reminder />
  <Filter client:only="react" data={data} storeKey={STORE_KEY}>
    <div slot="fallback" class="flex flex-wrap items-center gap-2 py-4">
      <div class="h-8 w-44 skeleton animate-pulse"></div>
      <div class="h-8 w-44 skeleton animate-pulse"></div>
      <div class="h-8 w-72 skeleton animate-pulse"></div>
      <div class="h-8 w-full skeleton animate-pulse"></div>
    </div>
  </Filter>
  <ListContainer client:only="react" round={round}>
    <div slot="fallback" class="w-full">
      <span class="loading loading-xl loading-spinner"> </span>
    </div>
  </ListContainer>
</RoundLayout>
