---
import type { GetStaticPaths } from 'astro'
import RoundLayout from '@/layouts/Round.astro'
import Violator from '@/components/round/violation/preact/Violator'
import ActionLog from '@/components/round/violation/preact/ActionLog'
import RelatedLogListContainer from '@/components/round/violation/preact/RelatedLogListContainer'
import LoadMore from '@/components/common/preact/LoadMore'
import ClientDatetime from '@/components/common/preact/ClientDatetime'
import OpenGraph from '@/components/layout/OpenGraph.astro'
import { getConnection } from '@/libs/databases'
import { getAllBasicViolationCase, getViolationCaseById } from '@/services/dbViolationCases'
import { getRelatedActionLog } from '@/services/dbViolationCaseActionLogs'
import { getViolationCaseRelatedLogs } from '@/services/dbLog'
import { getCurrentRound as getCurrentRoundFromDB } from '@/services/dbRound'
import {
  getCurrentRound,
  getViolationCaseUrl,
  getRoundMainPageUrl,
  getCurrentPageFullTitle,
} from '@/libs/routes'
import { stateBadgeClass, stateDisplayName, categoryDisplayName } from '@/utils/violation'
import { dataStoreKey } from '@/configs/general'
import { markdownToHtml, removeMarkdown, isLatestRound } from '@/utils/helpers'
import { legacyRounds, rounds } from '@/configs/sites'
import { flatten } from 'lodash-es'

export const getStaticPaths = (async () => {
  const results = await Promise.allSettled(
    rounds.map(async (round) => {
      const connection = getConnection(round)!

      let violationCases
      if (isLatestRound(round)) {
        violationCases = await getAllBasicViolationCase(connection)
      } else {
        const roundData = await getCurrentRoundFromDB(connection)
        violationCases = await getAllBasicViolationCase(connection, roundData!.beginDate)
      }
      violationCases = violationCases ?? []

      return violationCases.map((violationCase) => ({
        params: {
          round,
          caseId: violationCase._id,
        },
      }))
    }),
  )

  return flatten(
    results.filter((result) => result.status === 'fulfilled').map((result) => result.value),
  )
}) satisfies GetStaticPaths

const STORE_KEY = dataStoreKey.violationRelatedLog

const { caseId = '' } = Astro.params

const round = getCurrentRound(Astro)!

if (legacyRounds.includes(round)) {
  return Astro.redirect(getRoundMainPageUrl(round))
}

const connection = getConnection(round)

let violation
if (isLatestRound(round)) {
  violation = await getViolationCaseById(connection, caseId)
} else {
  const roundData = await getCurrentRoundFromDB(connection)
  violation = await getViolationCaseById(connection, caseId, roundData!.beginDate)
}

if (!violation) {
  return Astro.redirect(getRoundMainPageUrl(round))
}

const relatedActionLogs = await getRelatedActionLog(connection, caseId)
const relatedLogs = (await getViolationCaseRelatedLogs(connection, caseId)) ?? []

const title = getCurrentPageFullTitle(Astro)
const description = `案件識別碼：${violation._id}｜內容：${removeMarkdown(violation.description)}`
---

<RoundLayout useUserDict={true} useProductDict={true}>
  <OpenGraph slot="head-seo" title={title} description={description} />
  <h1 class="round-block-title">
    違規案件內容 - <span class="text-nowrap">{categoryDisplayName(violation.category)}</span>
  </h1>
  <div class="divider"></div>
  <div class="mb-1 flex items-center text-xl">
    目前狀態： <span class={`badge ${stateBadgeClass(violation.state)}`}
      >{stateDisplayName(violation.state)}</span
    >
  </div>
  <div>
    舉報時間：
    <span class="text-nowrap">
      <ClientDatetime client:only="preact" value={violation.createdAt} />
    </span>
  </div>
  <div>
    更新時間：
    <span class="text-nowrap">
      <ClientDatetime client:only="preact" value={violation.updatedAt} />
    </span>
  </div>
  <div data-case-id={violation._id}>
    案件識別碼：<span class="text-nowrap">{violation._id}</span>
  </div>
  <div class="divider"></div>
  <div class="flex flex-col gap-y-4">
    <div class="violation-case-detail-block">
      <p>違規名單</p>
      <ul class="break-all">
        {
          violation.violators.length > 0 ? (
            violation.violators.map((violator) => (
              <li>
                <Violator client:only="preact" {...violator} round={round} />
              </li>
            ))
          ) : (
            <em>一個都沒有！</em>
          )
        }
      </ul>
    </div>
    <div class="violation-case-detail-block">
      <p>相關案件</p>
      <ul>
        {
          violation.relatedCases.length > 0 ? (
            violation.relatedCases.map((caseId) => (
              <li>
                <a href={getViolationCaseUrl(round, caseId)}>{caseId}</a>
              </li>
            ))
          ) : (
            <em>並沒有。</em>
          )
        }
      </ul>
    </div>
    <div class="violation-case-detail-block">
      <p>案件描述</p>
      <div class="markdown-container px-3" set:html={markdownToHtml(violation.description)} />
    </div>
    <div class="violation-case-detail-block">
      <p>案件處理紀錄</p>
      <div class="px-4 py-2">
        {
          relatedActionLogs ? (
            relatedActionLogs.map((log) => (
              <ActionLog client:only="preact" {...log} round={round} />
            ))
          ) : (
            <em>沒有任何紀錄！</em>
          )
        }
      </div>
    </div>
    <div class="violation-case-detail-block">
      <p>案件相關遊戲紀錄</p>
      <div class="border border-base-content/25 p-6">
        <RelatedLogListContainer
          client:only="preact"
          storeKey={STORE_KEY}
          round={round}
          data={relatedLogs}
        />
        <LoadMore client:only="preact" storeKey={STORE_KEY} />
      </div>
    </div>
  </div>
</RoundLayout>
