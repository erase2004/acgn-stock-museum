---
export const prerender = false

import type {
  TypeCompanyCapitalRank,
  TypeCompanyPriceRank,
  TypeCompanyProfitRank,
  TypeCompanyValueRank,
  TypeUserWealthRank,
} from '@/components/round/seasonalReport/types'
import RoundLayout from '@/layouts/Round.astro'
import SeasonNavbar from '@/components/common/preact/SeasonNavbar'
import MainBody from '@/components/round/seasonalReport/preact/MainBody'
import { getConnection } from '@/libs/databases'
import { getCurrentRound, getRoundMainPageUrl } from '@/libs/routes'
import { getAllArchivedCompanies } from '@/services/dbCompanyArchive'
import { getAllArchivedUsers } from '@/services/dbUserArchive'
import { getPreviousSeason, getNextSeason, getSeasonById } from '@/services/dbSeason'
import { getRankCompanyCapitalBySeasonId } from '@/services/dbRankCompanyCapital'
import { getRankCompanyPriceBySeasonId } from '@/services/dbRankCompanyPrice'
import { getRankCompanyProfitBySeasonId } from '@/services/dbRankCompanyProfit'
import { getRankCompanyValueBySeasonId } from '@/services/dbRankCompanyValue'
import { getRankUserWealthBySeasonId } from '@/services/dbRankUserWealth'
import { getSeasonalReportUrl } from '@/libs/routes'
import { sortBy } from 'lodash-es'

const seasonId = Astro.params['seasonId']!
const round = getCurrentRound(Astro)!
const connection = getConnection(round)!

const homepage = getRoundMainPageUrl(round)

const currentSeason = await getSeasonById(connection, seasonId)
if (!currentSeason) {
  return Astro.redirect(homepage)
}

const previousSeason = await getPreviousSeason(connection, currentSeason)
const previousSeasonUrl = previousSeason
  ? getSeasonalReportUrl(round, previousSeason._id)
  : undefined

const nextSeason = await getNextSeason(connection, currentSeason)
const nextSeasonUrl = nextSeason ? getSeasonalReportUrl(round, nextSeason._id) : undefined

const allCompanies = await getAllArchivedCompanies(connection)
const allUsers = await getAllArchivedUsers(connection)
if (!allCompanies || !allUsers) {
  return Astro.redirect(homepage)
}

const allCompaniesDict = allCompanies.reduce(
  (acc, item) => {
    acc[item._id] = item.companyName
    return acc
  },
  {} as Record<string, string>,
)
const allUsersDict = allUsers.reduce(
  (acc, item) => {
    acc[item._id] = item.name
    return acc
  },
  {} as Record<string, string>,
)

function appendCompanyName<T extends Record<string, any>>(obj: T) {
  return Object.assign({}, obj, { companyName: allCompaniesDict[obj.companyId] })
}

function appendUserName<T extends Record<string, any>>(obj: T) {
  return Object.assign({}, obj, { name: allUsersDict[obj.userId] })
}

// company price rank
const rankCompanyPriceData = (await getRankCompanyPriceBySeasonId(connection, seasonId)) ?? []
const sortedRankCompanyPriceData: TypeCompanyPriceRank = sortBy(
  rankCompanyPriceData.map((item) => {
    return Object.assign({}, appendCompanyName(item), {
      totalMoney: item.totalDealMoney + item.productProfit,
    })
  }),
  'totalMoney',
)
sortedRankCompanyPriceData.reverse()

// company profit rank
const rankCompanyProfitData = (await getRankCompanyProfitBySeasonId(connection, seasonId)) ?? []
const sortedRankCompanyProfitData: TypeCompanyProfitRank = sortBy(
  rankCompanyProfitData.map(appendCompanyName),
  'priceToEarn',
)
sortedRankCompanyProfitData.reverse()

// company value rank
const rankCompanyValueData = (await getRankCompanyValueBySeasonId(connection, seasonId)) ?? []
const sortedRankCompanyValueData: TypeCompanyValueRank = sortBy(
  rankCompanyValueData.map((item) => {
    return Object.assign({}, appendCompanyName(item), {
      totalValue: item.lastPrice * item.totalRelease,
    })
  }),
  'totalValue',
)
sortedRankCompanyValueData.reverse()

// company capital rank
const rankCompanyCapitalData = (await getRankCompanyCapitalBySeasonId(connection, seasonId)) ?? []
const sortedRankCompanyCapitalData: TypeCompanyCapitalRank = sortBy(
  rankCompanyCapitalData.map(appendCompanyName),
  'capital',
)
sortedRankCompanyCapitalData.reverse()

// user wealth rank
const rankUserWealthData = (await getRankUserWealthBySeasonId(connection, seasonId)) ?? []
const sortedRankUserWealthData: TypeUserWealthRank = sortBy(
  rankUserWealthData.map((item) => {
    return Object.assign({}, appendUserName(item), { totalWealth: item.money + item.stocksValue })
  }),
  'totalWealth',
)
sortedRankUserWealthData.reverse()
---

<RoundLayout>
  <div>
    <h1 class="round-block-title">季度報告</h1>
    <div class="divider"></div>
    <SeasonNavbar
      currentSeason={currentSeason}
      previousSeasonUrl={previousSeasonUrl}
      nextSeasonUrl={nextSeasonUrl}
    />
    <div class="divider"></div>
    <MainBody
      client:only="preact"
      round={round}
      rankCompanyCapitalData={sortedRankCompanyCapitalData}
      rankCompanyPriceData={sortedRankCompanyPriceData}
      rankCompanyProfitData={sortedRankCompanyProfitData}
      rankCompanyValueData={sortedRankCompanyValueData}
      rankUserWealthData={sortedRankUserWealthData}
    />
  </div>
</RoundLayout>
