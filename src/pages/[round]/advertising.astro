---
import type { GetStaticPaths } from 'astro'
import dayjs from 'dayjs'
import RoundLayout from '@/layouts/Round.astro'
import UserLink from '@/components/common/preact/UserLink'
import ClientDatetime from '@/components/common/preact/ClientDatetime'
import { getConnection } from '@/libs/databases'
import { getCurrentRound } from '@/libs/routes'
import { getAdvertisements } from '@/services/dbAdvertising'
import { currencyFormat } from '@/utils/helpers'
import { advertisingExpireTime, displayAdvertisingNumber } from '@/configs/general'
import { rounds } from '@/configs/sites'

export const getStaticPaths = (() => {
  return rounds.map((round) => ({
    params: {
      round,
    },
  }))
}) satisfies GetStaticPaths

const round = getCurrentRound(Astro)!
const connection = getConnection(round)!
const advertisements = (await getAdvertisements(connection)) ?? []

function getExpireDate(begin: Date) {
  return dayjs(begin).add(advertisingExpireTime, 'ms').toDate()
}
---

<RoundLayout useUserDict={true}>
  <h1 class="round-block-title">廣告中心</h1>
  <div class="divider"></div>
  <h2 class="text-3xl opacity-70">進行中的廣告</h2>
  <div class="divider"></div>
  <table class="table-base custom-responsive-table-md table-pin-rows table">
    <thead>
      <tr>
        <th class="w-32 truncate text-center" title="購買者">購買者</th>
        <th class="truncate text-center" title="廣告內容">廣告內容</th>
        <th class="w-32 truncate text-center" title="費用">費用</th>
        <th class="w-52 truncate text-center" title="終止日期">終止日期</th>
      </tr>
    </thead>
    <tbody>
      {
        advertisements.length > 0 ? (
          advertisements.map((item, index) => (
            <tr
              class:list={[
                {
                  'bg-success/10': index < displayAdvertisingNumber,
                },
              ]}
            >
              <td class="truncate text-left text-nowrap" data-title="購買者">
                <UserLink client:only="react" round={round} userId={item.userId} />
              </td>
              <td class="text-left" data-title="廣告內容" title={item.message}>
                <div class="max-md:max-h-36 max-md:overflow-y-auto max-md:break-all md:truncate">
                  {item.url ? (
                    <a href={item.url} target="_blank">
                      {item.message}
                    </a>
                  ) : (
                    item.message
                  )}
                </div>
              </td>
              <td class="truncate text-center text-nowrap" data-title="費用">
                $ {currencyFormat(item.paid)}
              </td>
              <td class="text-truncate text-center md:text-nowrap" data-title="終止日期">
                <ClientDatetime client:only="react" value={getExpireDate(item.createdAt)} />
              </td>
            </tr>
          ))
        ) : (
          <tr class="default-content">
            <td class="truncate" colspan="4">
              目前沒有發布中廣告！
            </td>
          </tr>
        )
      }
    </tbody>
  </table>
</RoundLayout>
