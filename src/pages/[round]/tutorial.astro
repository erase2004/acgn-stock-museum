---
import type { GetStaticPaths } from 'astro'
import RoundLayout from '@/layouts/Round.astro'
import LegacyContent from '@/components/round/tutorial/LegacyContent.astro'
import Content from '@/components/round/tutorial/Content.astro'
import { z } from 'astro/zod'
import { UserRole } from '@/services/dbUsers'
import { getCurrentRound } from '@/libs/routes'
import { getConnection } from '@/libs/databases'
import { getDBUsers, schema as schemaUsers } from '@/services/dbUsers'
import { legacyRounds, rounds } from '@/configs/sites'
import { handlePromiseParser } from '@/utils/helpers'

export const getStaticPaths = (() => {
  return rounds.map((round) => ({
    params: {
      round,
    },
  }))
}) satisfies GetStaticPaths

const round = getCurrentRound(Astro)!
const connection = getConnection(round)!

const fscMembers =
  (await (async function () {
    const schema = schemaUsers.pick({ _id: true })
    const dbUsers = getDBUsers(connection)

    return handlePromiseParser(
      z.promise(schema.array()).parse(
        dbUsers
          .find({
            'profile.roles': { $elemMatch: { $eq: UserRole.FSC_MEMBER.name } },
          })
          .toArray(),
      ),
    )
  })()) ?? []

const isLegacyRound = legacyRounds.includes(round)
---

<RoundLayout useUserDict={true}>
  <h1 class="round-block-title">遊戲規則</h1>
  <div class="divider"></div>
  {
    !isLegacyRound && (
      <div class="bg-warning px-2 align-middle text-white">
        <i class="fa fa-warning" />
        遊戲規則內容已移至{' '}
        <a href="https://hackmd.io/@ACGN-stock/manual" target="_blank" rel="nofollow noreferrer">
          ACGN 股票交易市場說明手冊
        </a>
        ，本頁的內容將陸續整理過去。
      </div>
    )
  }
  <div class="tutorial-main">
    {isLegacyRound && <LegacyContent round={round} />}
    <Content round={round} fscMembers={fscMembers} />
  </div>
</RoundLayout>
