---
import type { GetStaticPaths } from 'astro'
import RoundLayout from '@/layouts/Round.astro'
import BasicInfo from '@/components/round/accountInfo/BasicInfo.astro'
import PanelFolder from '@/components/common/preact/PanelFolder'
import TaxInfoPanel from '@/components/round/accountInfo/TaxInfoPanel.astro'
import StockInfoPanel from '@/components/round/accountInfo/StockInfoPanel.astro'
import StoneInfoPanel from '@/components/round/accountInfo/StoneInfoPanel.astro'
import ProductInfoPanel from '@/components/round/accountInfo/ProductInfoPanel.astro'
import ViolationCaseInfo from '@/components/common/ViolationCaseInfo.astro'
import LogInfoPanel from '@/components/round/accountInfo/LogInfoPanel.astro'
import OpenGraph from '@/components/layout/OpenGraph.astro'
import { z } from 'astro/zod'
import { getConnection } from '@/libs/databases'
import { getCurrentPageFullTitle, getCurrentRound, getRoundMainPageUrl } from '@/libs/routes'
import { getAllBasicUsers, getDBUsers, schema as schemaUser } from '@/services/dbUsers'
import { handlePromiseParser } from '@/utils/helpers'
import { dataStoreKey } from '@/configs/general'
import { FIRST_ROUND, legacyRounds, rounds } from '@/configs/sites'
import { flatten } from 'lodash-es'

export const getStaticPaths = (async () => {
  const results = await Promise.allSettled(
    rounds.map(async (round) => {
      const connection = getConnection(round)!
      const users = (await getAllBasicUsers(connection)) ?? []

      return users.map((user) => ({
        params: {
          round,
          userId: user._id,
        },
      }))
    }),
  )

  return flatten(
    results.filter((result) => result.status === 'fulfilled').map((result) => result.value),
  )
}) satisfies GetStaticPaths

const userId = Astro.params['userId'] ?? ''
const round = getCurrentRound(Astro)!
const connection = getConnection(round)

const user = await (async function () {
  const dbUsers = getDBUsers(connection)

  return handlePromiseParser(
    // @ts-expect-error: userId is valid ObjectId
    z.promise(schemaUser).parse(dbUsers.findOne({ _id: userId })),
  )
})()

if (!user) {
  return Astro.redirect(getRoundMainPageUrl(round))
}

const isLegacyRound = legacyRounds.includes(round)
const isFirstRound = round === FIRST_ROUND

const title = getCurrentPageFullTitle(Astro, user.profile.name)
const description = user.about.description ?? ''
---

<RoundLayout useUserDict={true} useProductDict={true}>
  <OpenGraph
    slot="head-seo"
    title={title}
    description={description}
    image={user.about.picture || undefined}
  />
  <BasicInfo round={round} user={user} />
  <div class="account-detail">
    <div>
      <PanelFolder client:only="react" title="稅務資訊" classes="text-2xl" state={false}>
        <TaxInfoPanel round={round} userId={userId} />
      </PanelFolder>
    </div>
    <div>
      <PanelFolder client:only="react" title="持股資訊" classes="text-2xl" state={false}>
        <StockInfoPanel round={round} userId={userId} />
      </PanelFolder>
    </div>
    <div class="max-md:max-h-screen">
      <PanelFolder client:only="react" title="石頭資訊" classes="text-2xl" state={false}>
        <StoneInfoPanel round={round} userId={userId} profile={user.profile} />
      </PanelFolder>
    </div>
    <div>
      <PanelFolder
        client:only="react"
        title={isFirstRound ? '產品收藏' : '持有產品'}
        classes="text-2xl"
        state={false}
      >
        <ProductInfoPanel round={round} userId={userId} />
      </PanelFolder>
    </div>

    {
      !isLegacyRound && (
        <div class="max-md:max-h-screen">
          <PanelFolder client:only="react" title="違規案件列表" classes="text-2xl" state={false}>
            <ViolationCaseInfo
              type="userViolated"
              targetId={userId}
              storeKey={dataStoreKey.account.violation}
            />
          </PanelFolder>
        </div>
      )
    }
    <div class="max-h-screen">
      <PanelFolder client:only="react" title="玩家紀錄" classes="text-2xl" state={false}>
        <LogInfoPanel round={round} userId={userId} />
      </PanelFolder>
    </div>
  </div>
</RoundLayout>
