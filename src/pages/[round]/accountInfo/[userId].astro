---
export const prerender = false

import RoundLayout from '@/layouts/Round.astro'
import BasicInfo from '@/components/round/accountInfo/BasicInfo.astro'
import PanelFolder from '@/components/common/preact/PanelFolder'
import TaxList from '@/components/round/accountInfo/preact/TaxList'
import StockList from '@/components/round/accountInfo/preact/StockList'
import StoneList from '@/components/round/accountInfo/preact/StoneList'
import ProductList from '@/components/round/accountInfo/preact/ProductList'
import ViolationCaseInfo from '@/components/common/ViolationCaseInfo.astro'
import LogList from '@/components/round/accountInfo/preact/LogList'
import { z } from 'astro/zod'
import { getConnection } from '@/libs/databases'
import { getCurrentPageFullTitle, getCurrentRound, getRoundMainPageUrl } from '@/libs/routes'
import { getDBUsers, schema as schemaUser } from '@/services/dbUsers'
import { getDBTaxes, schema as schemaTax } from '@/services/dbTaxes'
import { getAccountOwnStocks } from '@/services/dbDirectors'
import { getDBCompanyStones, schema as schemaCompanyStone } from '@/services/dbCompanyStones'
import {
  getDBUserOwnedProduct,
  schema as schemaUserOwnedProduct,
} from '@/services/dbUserOwnedProduct'
import { getAccountLogs } from '@/services/dbLog'
import { handlePromiseParser } from '@/utils/helpers'
import { dataNumberPerPage, dataStoreKey } from '@/configs/general'

const userId = Astro.params['userId'] ?? ''
const round = getCurrentRound(Astro)!
const connection = getConnection(round)

const user = await (async function () {
  const dbUsers = getDBUsers(connection)

  return handlePromiseParser(
    // @ts-expect-error: userId is valid ObjectId
    z.promise(schemaUser).parse(dbUsers.findOne({ _id: userId })),
  )
})()

if (!user) {
  return Astro.redirect(getRoundMainPageUrl(round))
}

const title = getCurrentPageFullTitle(Astro, user.profile.name)

// tax info
const taxInfo =
  (await (async function () {
    const dbTaxes = getDBTaxes(connection)

    return handlePromiseParser(
      z.promise(schemaTax.array()).parse(dbTaxes.find({ userId }).toArray()),
    )
  })()) ?? []

// stock info
const stockInfo = await getAccountOwnStocks(connection, userId, true)

// stone info
const stoneInfo =
  (await (async function () {
    const dbCompanyStones = getDBCompanyStones(connection)

    return handlePromiseParser(
      z
        .promise(schemaCompanyStone.array())
        .parse(dbCompanyStones.find({ userId }, { sort: { placedAt: -1 } }).toArray()),
    )
  })()) ?? []

// product info

const productInfo =
  (await (async function () {
    const dbUserOwnedProduct = getDBUserOwnedProduct(connection)

    return handlePromiseParser(
      z
        .promise(schemaUserOwnedProduct.array())
        .parse(dbUserOwnedProduct.find({ userId }, { sort: { createdAt: 1 } }).toArray()),
    )
  })()) ?? []

// log info
const logs = (await getAccountLogs(connection, userId)) ?? []
---

<RoundLayout title={title} useUserDict={true} useProductDict={true}>
  <BasicInfo round={round} user={user} />
  <div class="account-detail">
    <div>
      <PanelFolder client:only="preact" title="稅務資訊" classes="text-2xl" state={false}>
        <TaxList client:only="preact" data={taxInfo} />
      </PanelFolder>
    </div>
    <div>
      <PanelFolder client:only="preact" title="持股資訊" classes="text-2xl" state={false}>
        <StockList client:only="preact" round={round} data={stockInfo?.[0]?.data ?? []} />
      </PanelFolder>
    </div>
    <div class="max-md:max-h-screen">
      <PanelFolder client:only="preact" title="石頭資訊" classes="text-2xl" state={false}>
        <StoneList client:only="preact" round={round} profile={user.profile} data={stoneInfo} />
      </PanelFolder>
    </div>
    <div>
      <PanelFolder client:only="preact" title="持有產品" classes="text-2xl" state={false}>
        <ProductList client:only="preact" round={round} data={productInfo} />
      </PanelFolder>
    </div>
    <div class="max-md:max-h-screen">
      <PanelFolder client:only="preact" title="違規案件列表" classes="text-2xl" state={false}>
        <ViolationCaseInfo
          type="userViolated"
          targetId={userId}
          storeKey={dataStoreKey.account.violation}
          pageSize={dataNumberPerPage.account.violation}
        />
      </PanelFolder>
    </div>
    <div class="max-h-screen">
      <PanelFolder client:only="preact" title="玩家紀錄" classes="text-2xl" state={false}>
        <LogList client:only="preact" round={round} data={logs} />
      </PanelFolder>
    </div>
  </div>
</RoundLayout>
