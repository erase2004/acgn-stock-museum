---
import type { GetStaticPaths } from 'astro'
import { getConnection } from '@/libs/databases'
import { getCurrentRound, getProductCenterBySeasonUrl } from '@/libs/routes'
import { getLatestSeason } from '@/services/dbSeason'
import { rounds } from '@/configs/sites'

export const getStaticPaths = (() => {
  return rounds.map((round) => ({
    params: {
      round,
    },
  }))
}) satisfies GetStaticPaths

const round = getCurrentRound(Astro)!
const connection = getConnection(round)!
const latestSeason = await getLatestSeason(connection)

return Astro.redirect(getProductCenterBySeasonUrl(round, latestSeason!._id))
---
