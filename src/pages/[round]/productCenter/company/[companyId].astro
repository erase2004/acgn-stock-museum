---
import type { GetStaticPaths } from 'astro'
import RoundLayout from '@/layouts/Round.astro'
import CompanyListContainer from '@/components/round/productCenter/preact/CompanyListContainer'
import CompanyListContainerForFirstRound from '@/components/round/productCenter/preact/CompanyListContainerForFirstRound'
import OpenGraph from '@/components/layout/OpenGraph.astro'
import { getConnection } from '@/libs/databases'
import { getCompanyUrl, getCurrentRound, getRoundMainPageUrl } from '@/libs/routes'
import {
  getAllBasicNonsealedCompanies,
  getCompanyFilterByCustomSchema,
  schema as schemaCompany,
} from '@/services/dbCompanies'
import { getProductsByCompany } from '@/services/dbProducts'
import { getCurrentPageFullTitle } from '@/libs/routes'
import { FIRST_ROUND, roundDefaultDescription, rounds } from '@/configs/sites'
import { flatten } from 'lodash-es'

export const getStaticPaths = (async () => {
  const results = await Promise.allSettled(
    rounds.map(async (round) => {
      const connection = getConnection(round)!
      const companies = (await getAllBasicNonsealedCompanies(connection)) ?? []

      return companies.map((company) => ({
        params: {
          round,
          companyId: company._id,
        },
      }))
    }),
  )

  return flatten(
    results.filter((result) => result.status === 'fulfilled').map((result) => result.value),
  )
}) satisfies GetStaticPaths

const companyId = Astro.params['companyId']!
const round = getCurrentRound(Astro)!
const connection = getConnection(round)!

const company = await getCompanyFilterByCustomSchema(
  connection,
  companyId,
  schemaCompany.pick({ companyName: true, isSeal: true }),
)
if (!company || company.isSeal) {
  return Astro.redirect(getRoundMainPageUrl(round))
}

const products = (await getProductsByCompany(connection, companyId)) ?? []

const isFirstRound = round === FIRST_ROUND

const title = getCurrentPageFullTitle(Astro, company.companyName)
---

<RoundLayout useProductDict={true}>
  <OpenGraph slot="head-seo" title={title} description={roundDefaultDescription} />
  <h1 class="round-block-title">產品中心</h1>
  <h2 class="my-2 text-3xl">
    <a href={getCompanyUrl(round, companyId)}>
      {company.companyName}
    </a>
  </h2>
  <div class="divider"></div>
  {
    isFirstRound ? (
      <CompanyListContainerForFirstRound client:only="react" data={products}>
        <div slot="fallback" class="w-full">
          <span class="loading loading-xl loading-spinner"> </span>
        </div>
      </CompanyListContainerForFirstRound>
    ) : (
      <CompanyListContainer client:only="react" data={products}>
        <div slot="fallback" class="w-full">
          <span class="loading loading-xl loading-spinner"> </span>
        </div>
      </CompanyListContainer>
    )
  }
</RoundLayout>
