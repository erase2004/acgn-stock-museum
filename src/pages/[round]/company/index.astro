---
import type { GetStaticPaths } from 'astro'
import RoundLayout from '@/layouts/Round.astro'
import Filter from '@/components/round/company/preact/Filter'
import ListContainer from '@/components/round/company/preact/ListContainer'
import { z } from 'astro/zod'
import { getConnection } from '@/libs/databases'
import { getCompanyUrl, getCurrentRound } from '@/libs/routes'
import { getDBCompanies, schema as schemaCompany } from '@/services/dbCompanies'
import { rounds } from '@/configs/sites'
import { handlePromiseParser } from '@/utils/helpers'

export const getStaticPaths = (() => {
  return rounds.map((round) => ({
    params: {
      round,
    },
  }))
}) satisfies GetStaticPaths

const round = getCurrentRound(Astro)!
const connection = getConnection(round)!

const itemAmount = 3

const companies =
  (await (async function () {
    const dbCompanies = getDBCompanies(connection)

    return handlePromiseParser(
      z
        .promise(schemaCompany.array())
        .parse(
          dbCompanies
            .find({ isSeal: false }, { sort: { lastPrice: -1 }, limit: itemAmount })
            .toArray(),
        ),
    )
  })()) ?? []

const ldJson = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: companies.slice(0, itemAmount).map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(getCompanyUrl(round, item._id), Astro.url),
  })),
}
const shouldShowLDJson = ldJson.itemListElement.length === itemAmount
---

<RoundLayout useUserDict={true}>
  {
    shouldShowLDJson && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(ldJson)} />
    )
  }
  <h1 class="round-block-title">股市總覽</h1>
  <div class="divider"></div>
  <Filter client:only="react" round={round}>
    <div slot="fallback" class="flex flex-wrap gap-1">
      <div class="h-10 w-12 skeleton animate-pulse"></div>
      <div class="h-10 w-30 skeleton animate-pulse"></div>
      <div class="h-10 w-40 skeleton animate-pulse"></div>
      <div class="join-vertical join w-full animate-pulse sm:join-horizontal md:w-auto">
        <div class="join-item h-10 w-full skeleton sm:w-60"></div>
        <div class="join-item h-10 w-full skeleton sm:w-30"></div>
        <div class="join-item h-10 w-full skeleton sm:w-20"></div>
      </div>
    </div>
  </Filter>
  <div class="divider"></div>
  <ListContainer client:only="react" round={round} />
</RoundLayout>
