---
import type { GetStaticPaths } from 'astro'
import type { ListItem } from '@/stores/company'
import RoundLayout from '@/layouts/Round.astro'
import Filter from '@/components/round/company/preact/Filter'
import ListContainer from '@/components/round/company/preact/ListContainer'
import LoadMore from '@/components/common/preact/LoadMore'
import { z } from 'astro/zod'
import { getConnection } from '@/libs/databases'
import { getCompanyUrl, getCurrentRound } from '@/libs/routes'
import { getCompanies } from '@/services/dbCompanies'
import { getDBEmployees, schema as schemaEmployee } from '@/services/dbEmployees'
import { handlePromiseParser } from '@/utils/helpers'
import { getCompanyEPS, getCompanyEPSForFirstRound } from '@/utils/company'
import { countBy } from 'lodash-es'
import { LIST_STORE_KEY } from '@/stores/company'
import { FIRST_ROUND, rounds } from '@/configs/sites'

export const getStaticPaths = (() => {
  return rounds.map((round) => ({
    params: {
      round,
    },
  }))
}) satisfies GetStaticPaths

const round = getCurrentRound(Astro)!
const connection = getConnection(round)!

const employeeMap = await (async function () {
  const dbEmployees = getDBEmployees(connection)

  const schema = schemaEmployee.pick({ companyId: true })
  const employees =
    (await handlePromiseParser(
      z.promise(schema.array()).parse(
        dbEmployees
          .find(
            {
              employed: true,
              resigned: false,
            },
            // @ts-expect-error: companyId field exists
            { companyId: 1 },
          )
          .toArray(),
      ),
    )) ?? []

  return countBy(employees, (item) => item.companyId)
})()

const isFirstRound = round === FIRST_ROUND

const companies = (await getCompanies(connection)) ?? []
const data: ListItem[] = companies.map((company) => {
  const employeeCount = employeeMap[company._id] || 0
  const eps = isFirstRound
    ? getCompanyEPSForFirstRound({ ...company, employeeCount })
    : getCompanyEPS({ ...company, employeeCount })

  return {
    ...company,
    employeeCount,
    eps,
  }
})

const itemAmount = 3
const ldJson = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: companies.slice(0, itemAmount).map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(getCompanyUrl(round, item._id), Astro.url),
  })),
}
const shouldShowLDJson = ldJson.itemListElement.length === itemAmount
---

<RoundLayout useUserDict={true}>
  {shouldShowLDJson && <script type="application/ld+json" set:html={JSON.stringify(ldJson)} />}
  <h1 class="round-block-title">股市總覽</h1>
  <div class="divider"></div>
  <Filter client:only="preact" data={data} />
  <div class="divider"></div>
  <ListContainer client:only="preact" round={round} storeKey={LIST_STORE_KEY} />
  <LoadMore client:only="preact" storeKey={LIST_STORE_KEY} />
</RoundLayout>
