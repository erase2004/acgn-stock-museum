---
import type { GetStaticPaths } from 'astro'
import RoundLayout from '@/layouts/Round.astro'
import SealedDetailContent from '@/components/round/company/SealedDetailContent.astro'
import NormalDetailContent from '@/components/round/company/NormalDetailContent.astro'
import OpenGraph from '@/components/layout/OpenGraph.astro'
import InconsistentCompanyIdReminder from '@/components/common/InconsistentCompanyIdReminder.astro'
import { getConnection } from '@/libs/databases'
import { getCurrentPageFullTitle, getCurrentRound, getRoundMainPageUrl } from '@/libs/routes'
import {
  getCompanyFilterByCustomSchema,
  getAllBasicCompanies,
  schema,
} from '@/services/dbCompanies'
import { rounds } from '@/configs/sites'
import { flatten } from 'lodash-es'
import { removeMarkdown } from '@/utils/helpers'

export const getStaticPaths = (async () => {
  const results = await Promise.allSettled(
    rounds.map(async (round) => {
      const connection = getConnection(round)!
      const companies = (await getAllBasicCompanies(connection)) ?? []

      return companies.map((company) => ({
        params: {
          round,
          companyId: company._id,
        },
      }))
    }),
  )

  return flatten(
    results.filter((result) => result.status === 'fulfilled').map((result) => result.value),
  )
}) satisfies GetStaticPaths

const companyId = Astro.params['companyId'] ?? ''
const round = getCurrentRound(Astro)!
const connection = getConnection(round)
const company = await getCompanyFilterByCustomSchema(
  connection,
  companyId,
  schema.pick({ companyName: true, isSeal: true, description: true, pictureSmall: true }),
)

if (!company) {
  return Astro.redirect(getRoundMainPageUrl(round))
}

const title = getCurrentPageFullTitle(Astro, company.companyName)
const description = removeMarkdown(company.description)
---

<RoundLayout useUserDict={true} useProductDict={true}>
  <OpenGraph slot="head-seo" title={title} description={description} image={company.pictureSmall} />
  <InconsistentCompanyIdReminder />
  {company.isSeal ? <SealedDetailContent /> : <NormalDetailContent />}
</RoundLayout>
