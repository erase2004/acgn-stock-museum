---
import type { GetStaticPaths } from 'astro'
import RoundLayout from '@/layouts/Round.astro'
import ListContainer from '@/components/round/fscLog/preact/ListContainer'
import Reminder from '@/components/common/Reminder.astro'
import { getConnection } from '@/libs/databases'
import { getCurrentRound } from '@/libs/routes'
import { fscLogTypeList, getDBLog } from '@/services/dbLog'
import { getCurrentRound as getCurrentRoundFromDB } from '@/services/dbRound'
import { legacyRounds, rounds } from '@/configs/sites'
import { z } from 'astro/zod'
import { handlePromiseParser, isLatestRound } from '@/utils/helpers'
import { integer } from '@/services/schema'

export const getStaticPaths = (() => {
  return rounds.map((round) => ({
    params: {
      round,
    },
  }))
}) satisfies GetStaticPaths

const round = getCurrentRound(Astro)!
const connection = getConnection(round)!

const filterRule = {
  logType: {
    $in: fscLogTypeList,
  },
}
if (!isLatestRound(round)) {
  const roundData = await getCurrentRoundFromDB(connection)

  Object.assign(filterRule, {
    createdAt: {
      $gte: roundData!.beginDate,
      $lt: roundData!.endDate,
    },
  })
}

const logAmount =
  (await (async function () {
    const dbLog = getDBLog(connection)

    return handlePromiseParser(z.promise(integer).parse(dbLog.countDocuments(filterRule)))
  })()) ?? 0

const isLegacyRound = legacyRounds.includes(round)
---

<RoundLayout useUserDict={true} useProductDict={true}>
  <h1 class="round-block-title">{isLegacyRound ? '舉報違規與金管會處理紀錄' : '金管會執行紀錄'}</h1>
  <div class="divider"></div>
  <Reminder />
  <p class="my-2">總共{logAmount}筆紀錄</p>
  <ListContainer client:only="react" round={round} />
</RoundLayout>
