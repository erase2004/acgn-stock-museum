---
export const prerender = false

import RoundLayout from '@/layouts/Round.astro'
import ListContainer from '@/components/round/fscLog/preact/ListContainer'
import LoadMore from '@/components/common/preact/LoadMore'
import { getConnection } from '@/libs/databases'
import { getCurrentRound } from '@/libs/routes'
import { fscLogTypeList, getDBLog, schema as schemaLog } from '@/services/dbLog'
import { getCurrentRound as getCurrentRoundFromDB } from '@/services/dbRound'
import { dataStoreKey } from '@/configs/general'
import { z } from 'astro/zod'
import { handlePromiseParser } from '@/utils/helpers'

const STORE_KEY = dataStoreKey.fscLogs

const round = getCurrentRound(Astro)!
const connection = getConnection(round)!

const currentRound = await getCurrentRoundFromDB(connection)

const fscLogs =
  (await (async function () {
    const dbLog = getDBLog(connection)

    return handlePromiseParser(
      z.promise(schemaLog.array()).parse(
        dbLog
          .find(
            {
              logType: {
                $in: fscLogTypeList,
              },
              createdAt: {
                $gte: currentRound!.beginDate,
                $lt: currentRound!.endDate,
              },
            },
            {
              sort: {
                createdAt: -1,
              },
            },
          )
          .toArray(),
      ),
    )
  })()) ?? []
---

<RoundLayout useUserDict={true} useCompanyDict={true} useProductDict={true}>
  <h1 class="round-block-title">金管會執行紀錄</h1>
  <div class="divider"></div>
  <p class="mb-2">總共{fscLogs.length}筆紀錄</p>
  <ListContainer client:only="preact" round={round} data={fscLogs} storeKey={STORE_KEY} />
  <LoadMore client:only="preact" storeKey={STORE_KEY} />
</RoundLayout>
