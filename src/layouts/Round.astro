---
import BaseLayout from '@/layouts/Base.astro'
import DataStoreInitilaztion from '@/components/layout/preact/DataStoreInitialization'
import { getCurrentRound } from '@/libs/routes'
import { getConnection } from '@/libs/databases'
import { getDBUserArchive, schema as schemaUserArchive } from '@/services/dbUserArchive'
import { z } from 'astro/zod'
import { handlePromiseParser } from '@/utils/helpers'
import { keyBy } from 'lodash-es'

type Props = Parameters<typeof BaseLayout>[0]
const props = Astro.props

const round = getCurrentRound(Astro)!
const connection = getConnection(round)
const userArchiveList =
  (await (async function () {
    const schema = schemaUserArchive.pick({
      _id: true,
      name: true,
      status: true,
      validateType: true,
    })
    const dbUserArchive = getDBUserArchive(connection)

    return handlePromiseParser(z.promise(schema.array()).parse(dbUserArchive.find({}).toArray()))
  })()) ?? []
const userArchiveData = keyBy(userArchiveList, '_id')
---

<BaseLayout {...props}>
  <div class="round-container">
    <div class="round-block"><slot /></div>
  </div>
  <DataStoreInitilaztion client:only="preact" userArchiveData={userArchiveData} />
  <!-- TODO: add loading effect -->
  <!-- TODO: add account dialog -->
  <!-- TODO: add alert dialog -->
</BaseLayout>
