---
import BaseLayout from '@/layouts/Base.astro'
import LoadUserJson from '@/components/layout/preact/LoadUserJson'
import LoadCompanyJson from '@/components/layout/preact/LoadCompanyJson'
import LoadProductJson from '@/components/layout/preact/LoadProductJson'
import OpenGraph from '@/components/layout/OpenGraph.astro'
import RoundNav from '@/components/layout/RoundNav.astro'
import RoundDrawerSide from '@/components/layout/RoundDrawerSide.astro'
import { getCurrentPageFullTitle, getCurrentRound } from '@/libs/routes'
import { roundDefaultDescription } from '@/configs/sites'

type Props = {
  useUserDict?: boolean
  useProductDict?: boolean
}
const props = Astro.props
const { useUserDict = false, useProductDict = false } = props

const round = getCurrentRound(Astro)

const title = getCurrentPageFullTitle(Astro)
---

<BaseLayout {...props}>
  <slot slot="head-seo" name="head-seo">
    <OpenGraph title={title} description={roundDefaultDescription} />
  </slot>
  <main class="drawer drawer-end container mx-auto px-4">
    <input id="hidden-drawer-input" type="checkbox" class="drawer-toggle" />
    <div class="relative drawer-content">
      <RoundNav />
      <div class="round-container">
        <div class="round-block"><slot /></div>
      </div>
      {useUserDict && <LoadUserJson client:only="preact" round={round!} />}
      <LoadCompanyJson client:only="preact" round={round!} />
      {useProductDict && <LoadProductJson client:only="preact" round={round!} />}
    </div>
    <RoundDrawerSide />
  </main>
</BaseLayout>
