---
import FounderTitleList from './preact/FounderTitleList'
import { z } from 'astro/zod'
import { getConnection } from '@/libs/databases'
import { getCurrentRound } from '@/libs/routes'
import { getDBCompanies, schema } from '@/services/dbCompanies'
import { handlePromiseParser } from '@/utils/helpers'

const userId = Astro.params['userId'] ?? ''
const round = getCurrentRound(Astro)!
const connection = getConnection(round)!
const dbCompanies = getDBCompanies(connection)

const data =
  (await handlePromiseParser(
    z
      .promise(schema.array())
      .parse(
        dbCompanies.find({ founder: userId, isSeal: false }, { sort: { createdAt: -1 } }).toArray(),
      ),
  )) ?? []
---

<FounderTitleList client:only="preact" round={round} data={data} />
