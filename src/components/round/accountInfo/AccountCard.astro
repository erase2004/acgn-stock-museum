---
import type { User } from '@/services/dbUsers'
import IconLogo from '@/assets/icons/logo.svg'
import UserLink from '@/components/common/preact/UserLink'
import { hasRole, UserRole } from '@/services/dbUsers'

type Props = Pick<User, '_id' | 'profile' | 'about'> & { round: string }

const { round, ...user } = Astro.props
const { _id, about } = user
const displayClass = hasRole(user, UserRole.SUPER_ADMIN.name)
  ? 'account-card-super-admin'
  : hasRole(user, UserRole.GENERAL_MANAGER.name)
    ? 'account-card-general-manager'
    : hasRole(user, UserRole.DEVELOPER.name)
      ? 'account-card-developer'
      : hasRole(user, UserRole.PLANNER.name)
        ? 'account-card-planner'
        : hasRole(user, UserRole.FSC_MEMBER.name)
          ? 'account-card-fsc'
          : 'account-card-default'
---

<div
  class={`max-h-[600px] max-w-[600px] rounded-md border border-solid border-base-content/25 shadow-[6px_6px_6px_var(--color-neutral-content)] ${displayClass}`}
>
  <div class="m-2 flex *:px-4">
    <div class="w-1/3 *:max-h-[500px] *:w-full *:max-w-full *:rounded-[10%] *:object-cover">
      {
        about.picture ? (
          <img src={about.picture} alt="使用者頭像" />
        ) : (
          <img src={IconLogo.src} alt="預設使用者頭像" />
        )
      }
    </div>

    <div class="w-2/3 py-2">
      <div>
        <div class="mb-1 flex flex-col gap-y-2">
          <p class="truncate text-3xl">
            <UserLink client:only="react" round={round} userId={_id} />
          </p>
          <span>
            {_id}
          </span>
        </div>

        <div class="text-right">
          {about.description}
        </div>
      </div>
    </div>
  </div>
</div>
