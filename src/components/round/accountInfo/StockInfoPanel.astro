---
import StockList from './preact/StockList'
import { getConnection } from '@/libs/databases'
import { getAccountOwnStocks } from '@/services/dbDirectors'

type Props = {
  round: string
  userId: string
}

const { round, userId } = Astro.props

const connection = getConnection(round)
const stockInfo = (await getAccountOwnStocks(connection, userId)) ?? []
---

<div class="panel-content">
  <p>總共{stockInfo.length}筆</p>
  <StockList client:only="react" round={round} data={stockInfo} />
</div>
