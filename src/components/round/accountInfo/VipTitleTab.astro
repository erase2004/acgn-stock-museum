---
import VipTitleList from './preact/VipTitleList'
import { z } from 'astro/zod'
import { getConnection } from '@/libs/databases'
import { getCurrentRound } from '@/libs/routes'
import { getDBVips, schema } from '@/services/dbVips'
import { handlePromiseParser } from '@/utils/helpers'

const userId = Astro.params['userId'] ?? ''
const round = getCurrentRound(Astro)!
const connection = getConnection(round)!
const dbVips = getDBVips(connection)

const data =
  (await handlePromiseParser(
    z.promise(schema.array()).parse(dbVips.find({ userId }, { sort: { level: -1 } }).toArray()),
  )) ?? []
---

<VipTitleList client:only="preact" round={round} data={data} />
