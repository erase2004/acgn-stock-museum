---
import EmployeeList from './preact/EmployeeList'
import { z } from 'astro/zod'
import { getConnection } from '@/libs/databases'
import { getDBEmployees, schema as schemaEmployee } from '@/services/dbEmployees'
import { getCompanyFilterByCustomSchema, schema as schemaCompany } from '@/services/dbCompanies'
import { currencyFormat, handlePromiseParser } from '@/utils/helpers'
import { dataStoreKey, defaultCompanySalaryPerDay } from '@/configs/general'
import { dataNumberPerPage } from '@/configs/general'

type Props = {
  round: string
  companyId: string
}
const { round, companyId } = Astro.props

const connection = getConnection(round)

const [salary, nextSeasonSalary] = await (async function () {
  const schema = schemaCompany.pick({ salary: true, nextSeasonSalary: true })
  const companyData = await getCompanyFilterByCustomSchema(connection, companyId, schema)
  return companyData
    ? [companyData.salary, companyData.nextSeasonSalary]
    : [defaultCompanySalaryPerDay, defaultCompanySalaryPerDay]
})()

const dbEmployees = getDBEmployees(connection)
const employees =
  (await handlePromiseParser(
    z
      .promise(schemaEmployee.array())
      .parse(dbEmployees.find({ companyId }, { sort: { registerAt: 1 } }).toArray()),
  )) ?? []

const currentSeasonEmployees = employees.filter((i) => i.employed === true)
const nextSeasonEmployees = employees.filter((i) => i.employed === false)
---

<div class="flex flex-col text-success sm:flex-row">
  <p>本季度員工薪資：${currencyFormat(salary)}</p>
  <div class="divider mx-0 divider-horizontal"></div>
  <p>下季度員工薪資：${currencyFormat(nextSeasonSalary)}</p>
</div>
<EmployeeList
  client:only="preact"
  type="current"
  round={round}
  storeKey={dataStoreKey.company.employee.current}
  pageSize={dataNumberPerPage.company.employee.current}
  data={currentSeasonEmployees}
/>

<EmployeeList
  client:only="preact"
  type="next"
  round={round}
  storeKey={dataStoreKey.company.employee.next}
  pageSize={dataNumberPerPage.company.employee.next}
  data={nextSeasonEmployees}
/>
