---
import PanelFolder from '@/components/common/preact/PanelFolder'
import CompanyChartPanel from './CompanyChartPanel.astro'
import CompanyMarketDataPanel from './CompanyMarketDataPanel.astro'
import CompanyProfitDistributionPanel from './CompanyProfitDistributionPanel.astro'
import CompanyOrderBookPanel from './CompanyOrderBookPanel.astro'
import CompanyProductCenterPanel from './CompanyProductCenterPanel.astro'
import CompanyDirectorPanel from './CompanyDirectorPanel.astro'
import CompanyVipPanel from './CompanyVipPanel.astro'
import CompanyEmployeePanel from './CompanyEmployeePanel.astro'
import CompanyArenaPanel from './CompanyArenaPanel.astro'
import CompanyMiningMachinePanel from './CompanyMiningMachinePanel.astro'
import ViolationCaseInfo from '@/components/common/ViolationCaseInfo.astro'
import CompanyLogInfo from './CompanyLogInfo.astro'
import { getCurrentRound } from '@/libs/routes'
import { dataStoreKey } from '@/configs/general'
import { FIRST_ROUND, legacyRounds } from '@/configs/sites'

type Props = {
  companyId: string
}

const { companyId } = Astro.props
const round = getCurrentRound(Astro)!

const isLegacyRound = legacyRounds.includes(round)
const isFirstRound = round === FIRST_ROUND
---

<div class="company-detail">
  {/* 股價趨勢 */}
  <div class="panel-container">
    <PanelFolder client:only="react" title="股價趨勢" state={false} classes="panel-head">
      <CompanyChartPanel round={round} companyId={companyId} />
    </PanelFolder>
  </div>
  {/* 數據資訊 */}
  <div class="panel-container">
    <PanelFolder client:only="react" title="數據資訊" state={false} classes="panel-head">
      <CompanyMarketDataPanel round={round} companyId={companyId} />
    </PanelFolder>
  </div>

  {/* 營利分配資訊 */}
  <div class="panel-container">
    <PanelFolder client:only="react" title="營利分配資訊" state={false} classes="panel-head">
      <CompanyProfitDistributionPanel companyId={companyId} />
    </PanelFolder>
  </div>

  {/* 交易訂單 */}
  <div class="panel-container">
    <PanelFolder client:only="react" title="交易訂單" state={false} classes="panel-head">
      <CompanyOrderBookPanel />
    </PanelFolder>
  </div>

  {/* 產品中心 */}
  <div class="panel-container">
    <PanelFolder client:only="react" title="產品中心" state={false} classes="panel-head">
      <CompanyProductCenterPanel round={round} companyId={companyId} />
    </PanelFolder>
  </div>

  {/* 董事會 */}
  <div class="panel-container">
    <PanelFolder client:only="react" title="董事會" state={false} classes="panel-head">
      <CompanyDirectorPanel round={round} companyId={companyId} />
    </PanelFolder>
  </div>

  {/* VIP 名冊 */}
  {
    !isFirstRound && (
      <div class="panel-container">
        <PanelFolder client:only="react" title="VIP名冊" state={false} classes="panel-head">
          <CompanyVipPanel round={round} companyId={companyId} />
        </PanelFolder>
      </div>
    )
  }

  {/* 員工名冊 */}
  <div class="panel-container">
    <PanelFolder client:only="react" title="員工名冊" state={false} classes="panel-head">
      <CompanyEmployeePanel round={round} companyId={companyId} />
    </PanelFolder>
  </div>

  {/* 最萌亂鬥大賽 */}
  <div class="panel-container">
    <PanelFolder client:only="react" title="最萌亂鬥大賽" state={false} classes="panel-head">
      <CompanyArenaPanel round={round} companyId={companyId} />
    </PanelFolder>
  </div>

  {/* 挖礦機 */}
  <div class="panel-container">
    <PanelFolder client:only="react" title="挖礦機" state={false} classes="panel-head">
      <CompanyMiningMachinePanel round={round} companyId={companyId} />
    </PanelFolder>
  </div>

  {/* 違規案件列表 */}
  {
    !isLegacyRound && (
      <div class="panel-container **:[.panel-content]:max-h-72 max-md:**:[.panel-content]:max-h-screen">
        <PanelFolder client:only="react" title="違規案件列表" state={false} classes="panel-head">
          <ViolationCaseInfo
            type="companyViolated"
            targetId={companyId}
            storeKey={dataStoreKey.company.violation}
          />
        </PanelFolder>
      </div>
    )
  }

  {/* 所有紀錄 */}
  <div class="panel-container">
    <PanelFolder client:only="react" title="所有紀錄" state={false} classes="panel-head">
      <CompanyLogInfo companyId={companyId} />
    </PanelFolder>
  </div>
</div>
