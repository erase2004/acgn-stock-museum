---
import PanelFolder from '@/components/common/preact/PanelFolder'
import CompanyMarketDataPanel from './CompanyMarketDataPanel.astro'
import CompanyProfitDistributionPanel from './CompanyProfitDistributionPanel.astro'
import CompanyOrderBook from './CompanyOrderBook.astro'
import CompanyProductCenterPanel from './CompanyProductCenterPanel.astro'
import CompanyDirectorInfo from './CompanyDirectorInfo.astro'
import CompanyVipInfo from './CompanyVipInfo.astro'
import { getCurrentRound } from '@/libs/routes'

type Props = {
  companyId: string
}

const { companyId } = Astro.props
const round = getCurrentRound(Astro)!
---

<div class="-mx-4 border border-base-content/25 *:border-base-content/25 *:not-last:border-b">
  {/* 股價趨勢 */}

  {/* 數據資訊 */}
  <div>
    <PanelFolder client:only="preact" title="數據資訊" state={false} classes="text-2xl px-4">
      <CompanyMarketDataPanel round={round} companyId={companyId} />
    </PanelFolder>
  </div>

  {/* 營利分配資訊 */}
  <div>
    <PanelFolder client:only="preact" title="營利分配資訊" state={false} classes="text-2xl px-4">
      <CompanyProfitDistributionPanel companyId={companyId} />
    </PanelFolder>
  </div>

  {/* 交易訂單 */}
  <div>
    <PanelFolder client:only="preact" title="交易訂單" state={false} classes="text-2xl px-4">
      <CompanyOrderBook />
    </PanelFolder>
  </div>

  {/* 產品中心 */}
  <div>
    <PanelFolder client:only="preact" title="產品中心" state={false} classes="text-2xl px-4">
      <CompanyProductCenterPanel round={round} companyId={companyId} />
    </PanelFolder>
  </div>

  {/* 董事會 */}
  <div>
    <PanelFolder client:only="preact" title="董事會" state={false} classes="text-2xl px-4">
      <CompanyDirectorInfo round={round} companyId={companyId} />
    </PanelFolder>
  </div>

  {/* VIP 名冊 */}
  <div>
    <PanelFolder client:only="preact" title="VIP名冊" state={false} classes="text-2xl px-4">
      <CompanyVipInfo round={round} companyId={companyId} />
    </PanelFolder>
  </div>

  {/* 員工名冊 */}

  {/* 最萌亂鬥大賽 */}

  {/* 挖礦機 */}

  {/* 違規案件列表 */}

  {/* 所有紀錄 */}
</div>
