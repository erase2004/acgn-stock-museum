---
import { companyProfitDistributionForFirstRound } from '@/configs/general'

type Props = {
  employeeBonusRatePercent?: number
}

const { employeeBonusRatePercent = 0 } = Astro.props

const { incomeTaxRatePercent, managerBonusRatePercent } = companyProfitDistributionForFirstRound

const directorBonusRatePercent =
  100 - incomeTaxRatePercent - managerBonusRatePercent - employeeBonusRatePercent
---

<div class="company-profit-distribution-panel">
  <div class="col-span-6 md:col-span-3">
    <p>公司所得稅</p>
    <p>{incomeTaxRatePercent}%</p>
  </div>
  <div class="col-span-6 md:col-span-3">
    <p>經理分紅</p>
    <p>{managerBonusRatePercent}%</p>
  </div>
  <div class="col-span-6 md:col-span-3">
    <p>員工分紅</p>
    <p>{employeeBonusRatePercent}%</p>
  </div>
  <div class="col-span-6 md:col-span-3">
    <p>股東分紅</p>
    <p>{directorBonusRatePercent}%</p>
  </div>
</div>
