---
import ChartsOverview from './preact/ChartsOverview'
import { z } from 'astro/zod'
import { getConnection } from '@/libs/databases'
import { getCurrentRound } from '@/services/dbRound'
import { getDBPrice, schema as schemaPrice } from '@/services/dbPrice'
import { handlePromiseParser } from '@/utils/helpers'

type Props = {
  round: string
  companyId: string
}
const { round, companyId } = Astro.props

const connection = getConnection(round)

const roundEnd = await (async function () {
  const roundData = await getCurrentRound(connection)
  return roundData!.endDate
})()

const priceData =
  (await (async function () {
    const dbPrice = getDBPrice(connection)

    return handlePromiseParser(
      z
        .promise(schemaPrice.array())
        .parse(dbPrice.find({ companyId }, { sort: { createdAt: 1 } }).toArray()),
    )
  })()) ?? []
---

<ChartsOverview client:only="react" roundEnd={roundEnd} data={priceData} />
