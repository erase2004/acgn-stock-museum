---
import ProfitDistributionForFirstRoundInfo from './ProfitDistributionForFirstRoundInfo.astro'
import ProfitDistributionInfo from './ProfitDistributionInfo.astro'
import { FIRST_ROUND } from '@/configs/sites'
import { getConnection } from '@/libs/databases'
import { getCurrentRound } from '@/libs/routes'
import { getCompanyFilterByCustomSchema, schema as schemaCompany } from '@/services/dbCompanies'

type Props = {
  companyId: string
}

const { companyId } = Astro.props

const round = getCurrentRound(Astro)!
const connection = getConnection(round)

const company = await (async function () {
  const schema = schemaCompany.pick({
    capitalIncreaseRatePercent: true,
    managerBonusRatePercent: true,
    employeeBonusRatePercent: true,
  })
  return getCompanyFilterByCustomSchema(connection, companyId, schema)
})()

const isFirstRound = round === FIRST_ROUND
---

<div class="panel-content">
  {
    isFirstRound ? (
      <ProfitDistributionForFirstRoundInfo {...company} />
    ) : (
      <ProfitDistributionInfo {...company} />
    )
  }
</div>
