---
import type { z } from 'astro/zod'
import type { schema as schemaIssue } from '@/services/dbRuleIssues'
import type { schema as schemaIssueOption } from '@/services/dbRuleIssueOptions'
import Option from './Option.astro'

type Props = {
  index: number
  round: string
  issue: Omit<z.infer<typeof schemaIssue>, 'options'> & {
    options: Array<z.infer<typeof schemaIssueOption>>
  }
}

const {
  index,
  round,
  issue: { title, options },
} = Astro.props
---

<div class="divider"></div>
<div>
  <h4 class="text-xl">議題{index + 1}：{title}</h4>
  <ul class="border-selector list mt-2 border border-base-content/25 pl-0">
    {options.map((option) => <Option round={round} prefix={index.toString()} option={option} />)}
  </ul>
</div>
