---
import type { z } from 'astro/zod'
import type { agendaListSchema } from '@/services/dbRuleAgendas'
import { formatDateTimeText } from '@/libs/timeFormat'
import { getPageUrl, PAGE } from '@/libs/routes'

type Props = {
  type: '進行中' | '已結束'
  round: string
  data: z.infer<typeof agendaListSchema>
}

const { type, round, data } = Astro.props
const hasData = data.length > 0

function getAgendaHref(agendaId: string) {
  return getPageUrl({
    round,
    pageName: PAGE.RULE_AGENDA_DETAIL,
    params: agendaId,
  })
}
---

<table class="table-base custom-responsive-table-md table">
  <thead>
    <tr>
      <th class="w-3/5 truncate text-center" title="議程主題">議程主題</th>
      <th class="truncate text-center" title="結束日期">結束日期</th>
      <th class="w-[10%] truncate px-0 text-center" title="相關討論">相關討論</th>
    </tr>
  </thead>
  <tbody>
    {
      hasData ? (
        data.map((agenda) => {
          return (
            <tr>
              <td class="truncate text-left" data-title="議程主題">
                <a href={getAgendaHref(agenda._id)}>{agenda.title}</a>
              </td>
              <td class="truncate text-center" data-title="結束日期">
                {formatDateTimeText(agenda.endedAt)}
              </td>
              <td class="px-0 text-center" data-title="相關討論">
                <a
                  class="btn text-nowrap btn-xs btn-primary"
                  href={agenda.discussionUrl}
                  target="_blank"
                >
                  連結
                </a>
              </td>
            </tr>
          )
        })
      ) : (
        <Fragment>
          <tr class="default-content">
            <td class="text-center" colspan={3}>
              沒有{type}的議程！
            </td>
          </tr>
        </Fragment>
      )
    }
  </tbody>
</table>
