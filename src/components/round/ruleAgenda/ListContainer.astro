---
import ClientDatetime from '@/components/common/preact/ClientDatetime'
import type { z } from 'astro/zod'
import type { agendaListSchema } from '@/services/dbRuleAgendas'
import { getRuleAgendaUrl } from '@/libs/routes'

type Props = {
  type: '進行中' | '已結束'
  round: string
  data: z.infer<typeof agendaListSchema>
}

const { type, round, data } = Astro.props
const hasData = data.length > 0
---

<table class="table-base custom-responsive-table-md table-pin-rows table">
  <thead>
    <tr>
      <th class="w-3/5 text-center" title="議程主題">議程主題</th>
      <th class="text-center" title="結束日期">結束日期</th>
      <th class="w-[10%] px-0 text-center" title="相關討論">相關討論</th>
    </tr>
  </thead>
  <tbody>
    {
      hasData ? (
        data.map((agenda) => {
          return (
            <tr class="*:px-2">
              <td class="text-left" data-title="議程主題">
                <a href={getRuleAgendaUrl(round, agenda._id)}>{agenda.title}</a>
              </td>
              <td class="text-center" data-title="結束日期">
                <ClientDatetime client:only="preact" value={agenda.endedAt} />
              </td>
              <td class="px-0 text-center" data-title="相關討論">
                <a
                  class="btn text-nowrap btn-xs btn-primary"
                  href={agenda.discussionUrl}
                  target="_blank"
                >
                  連結
                </a>
              </td>
            </tr>
          )
        })
      ) : (
        <tr class="default-content">
          <td colspan={3}>沒有{type}的議程！</td>
        </tr>
      )
    }
  </tbody>
</table>
