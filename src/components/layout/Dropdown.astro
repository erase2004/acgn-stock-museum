---
import type { Round } from '@/configs/sites'
import DropdownItem from './DropdownItem.astro'

type Props = {
  year: string
  list: Round[]
}

const { year, list } = Astro.props
---

<li class="dropdown dropdown-center dropdown-bottom first:dropdown-start last:dropdown-end">
  <div
    tabindex="0"
    role="button"
    class="menu-dropdown-toggle btn h-7 rounded-field text-primary-content btn-ghost"
  >
    {year}
  </div>
  <ul class="dropdown-content rounded-box bg-base-300 shadow-sm">
    {list.map((site) => <DropdownItem site={site} />)}
  </ul>
</li>
