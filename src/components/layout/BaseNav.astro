---
import ThemeToggle from './ThemeToggle.astro'
---

<nav class="navbar z-20 bg-base-300 **:not-[.ignore-inherit]:text-inherit max-md:min-h-0">
  <ul class="menu menu-horizontal hidden w-full flex-nowrap text-base md:flex">
    <div class="divider mr-0 ml-auto divider-horizontal"></div>
    <ThemeToggle />
  </ul>
  <div class="col-start-2 md:hidden">
    <label for="hidden-drawer-input" aria-label="open sidebar" class="btn btn-square btn-ghost">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        class="inline-block h-6 w-6 stroke-current"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </label>
  </div>
</nav>
