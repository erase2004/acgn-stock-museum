---
import ThemeToggle from './ThemeToggle.astro'
import Accordion from './Accordion.astro'
import { siteList, feedbackUrl } from '@/configs/sites'
import { groupBy } from 'lodash-es'

const data = groupBy(siteList, 'year')
---

<div class="drawer-side z-50 **:not-[.ignore-inherit]:text-inherit">
  <label for="hidden-drawer-input" aria-label="close sidebar" class="drawer-overlay"></label>
  <div class="flex h-screen flex-col overflow-y-hidden bg-base-100 **:bg-base-100">
    <div class="flex items-center justify-end p-1">
      <a
        class="ignore-inherit btn btn-soft btn-sm"
        href={feedbackUrl}
        target="_blank"
        rel="nofollow noreferrer"
      >
        問題回報<i class="fa fa-external-link ml-1"></i>
      </a>
      <div class="divider mx-0 divider-horizontal"></div>
      <ThemeToggle />
      <label
        for="hidden-drawer-input"
        aria-label="close sidebar"
        class="btn btn-circle border-0 text-xl shadow-none btn-md"
      >
        ✕
      </label>
    </div>
    <div class="divider my-0"></div>
    <div></div>
    <div class="overflow-y-scroll">
      {
        Object.entries(data)
          .reverse()
          .map(([year, list]) => <Accordion year={year} list={list} />)
      }
    </div>
  </div>
</div>
