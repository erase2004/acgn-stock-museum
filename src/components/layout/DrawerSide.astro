---
import BaseDrawerSide from './BaseDrawerSide.astro'
import RoundDrawerSide from './RoundDrawerSide.astro'
import ThemeToggle from './ThemeToggle.astro'
import { checkIsValidRound, getCurrentRound } from '@/libs/routes'

const round = getCurrentRound(Astro)
const isValidRound = checkIsValidRound(round)
---

<div class="drawer-side">
  <label for="hidden-drawer-input" aria-label="close sidebar" class="drawer-overlay"></label>
  <div class="flex h-screen min-w-1/2 flex-col overflow-y-hidden bg-base-100 **:bg-base-100">
    <div class="flex justify-end p-1">
      <ThemeToggle />
      <label
        for="hidden-drawer-input"
        aria-label="close sidebar"
        class="btn btn-circle border-0 text-xl shadow-none btn-md"
      >
        ✕
      </label>
    </div>
    <div class="divider my-0"></div>
    <div></div>
    <div class="overflow-y-scroll">
      <ul class="menu">
        {isValidRound ? <RoundDrawerSide /> : <BaseDrawerSide />}
      </ul>
    </div>
  </div>
</div>
