---

<button
  aria-label="回到頁首"
  type="button"
  class="btn fixed end-5 bottom-5 z-10 size-9 rounded-full shadow-lg/50 ring shadow-base-content ring-base-content/25 transition-transform duration-300 btn-accent md:size-12"
  id="btn-back-to-top"
>
  <i class="fa fa-chevron-up !text-lg text-base-100 md:!text-2xl" aria-hidden="true"></i>
</button>

<script>
  const button = document.getElementById('btn-back-to-top')

  let prevScrollY = 0

  const scrollFunction = () => {
    if (!button) return

    const scrollY = window.scrollY

    if (scrollY > 20 && scrollY > prevScrollY) {
      button.classList.remove('translate-y-20')
    } else {
      button.classList.add('translate-y-20')
    }

    prevScrollY = scrollY
  }
  const backToTop = () => {
    window.scrollTo({ top: 0, behavior: 'smooth' })
  }

  button!.addEventListener('click', backToTop)
  window.addEventListener('scroll', scrollFunction)

  scrollFunction()
</script>
