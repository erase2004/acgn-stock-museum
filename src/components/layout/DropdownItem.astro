---
import type { Round } from '@/configs/sites'
import { isString } from 'lodash-es'

type Props = {
  site: Round
}

const { site } = Astro.props
const isExternal = isString(site.externalUrl)
const url = site.disabled
  ? '#'
  : isExternal
    ? site.externalUrl
    : `/round${site.dbname!.split('-')[1]}`
---

<li class="*:text-nowrap">
  {
    site.disabled ? (
      <button class="btn-disabled btn h-auto border-none px-3 py-1.5 font-medium opacity-50">
        {site.title}
      </button>
    ) : (
      <a href={url} class="GTM-site-link" target={isExternal ? '_blank' : '_self'} rel="noopener">
        {site.title}
      </a>
    )
  }
</li>
