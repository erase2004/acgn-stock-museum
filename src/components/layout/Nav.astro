---
import BaseNav from './BaseNav.astro'
import RoundNav from './RoundNav.astro'
import { checkIsRound } from '@/libs/routes'

const isRound = checkIsRound(Astro)
---

<nav class="navbar bg-base-300 max-md:min-h-0">
  <div class="ml-auto flex-none md:hidden">
    <label for="hidden-drawer-input" aria-label="open sidebar" class="btn btn-square btn-ghost">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        class="inline-block h-6 w-6 stroke-current"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </label>
  </div>
  {isRound ? <RoundNav /> : <BaseNav />}
</nav>
